<div class="player-container" data-controller="video-player"
     data-video-player-streaming-url-value="<%= @streaming_url %>"
     data-video-player-source-value="<%= @source_token %>"
     data-video-player-direct-stream-url-value="<%= @direct_stream_url %>"
     data-video-player-direct-play-hint-value="<%= @direct_play_hint %>"
     data-video-player-filename-value="<%= @filename %>"
     data-video-player-imdb-id-value="<%= @imdb_id %>"
     data-video-player-type-value="<%= @type %>"
     data-video-player-season-value="<%= @season %>"
     data-video-player-episode-value="<%= @episode %>"
     data-video-player-resume-at-value="<%= @resume_at %>"
     data-video-player-start-seconds-value="<%= @resume_at.present? ? @resume_at : 0 %>"
     data-video-player-duration-value="<%= @duration || 0 %>"
     data-video-player-title-value="<%= @title %>"
     data-video-player-poster-url-value="<%= @poster_url %>"
     data-video-player-default-language-value="<%= @default_language %>"
     data-video-player-preferred-languages-value="<%= @preferred_languages.to_json %>"
     data-video-player-tracks-url-value="<%= transcode_tracks_path %>"
     data-video-player-seek-url-value="<%= transcode_seek_path %>"
     data-video-player-subtitles-url-value="<%= transcode_subtitles_path %>"
     data-video-player-progress-url-value="<%= progress_streaming_path("play") %>"
     data-video-player-next-episode-url-value="<%= next_episode_streaming_path("play", playback: params[:playback]) if @type == "show" %>"
     data-video-player-next-episode-prompt-seconds-value="<%= @next_episode_prompt_seconds %>"
     data-video-player-resume-url-value="<%= resume_streaming_index_path %>">

  <%# Top bar: back affordance plus the episode headline.  The episode name is
      the headline and the "Show · S01E02" line is the context, so an episode
      title is never hidden behind a back button. %>
  <div class="absolute inset-x-0 top-0 z-50 flex items-start gap-2 bg-gradient-to-b from-black/85 via-black/35 to-transparent px-3 pb-10 opacity-100 transition-opacity duration-500"
       data-video-player-target="backButton"
       style="padding-top: calc(env(safe-area-inset-top, 0px) + 0.6rem); padding-left: calc(env(safe-area-inset-left, 0px) + 0.6rem);">
    <%= link_to content_path(type: @type, imdb_id: @imdb_id, season: @season),
          class: "-ml-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-white/90 transition-colors hover:bg-white/10 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-white/60",
          aria: { label: "Back to title" },
          data: { action: "click->video-player#navigateBack" } do %>
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
    <% end %>

    <div class="min-w-0 pt-1.5">
      <% if @display_subtitle.present? %>
        <p data-video-player-target="positionLabel" class="truncate text-[11px] font-medium uppercase tracking-[0.14em] text-white/60"><%= @display_subtitle %></p>
      <% end %>
      <h1 data-video-player-target="titleLabel" class="truncate text-base font-semibold leading-tight text-white drop-shadow sm:text-lg"><%= @display_title %></h1>
    </div>
  </div>

  <%# Source info (top right, auto-hides) %>
  <div data-video-player-target="sourceInfo" class="hidden absolute top-4 right-4 z-10 max-w-lg opacity-100 transition-opacity duration-500"
       style="top: calc(env(safe-area-inset-top, 0px) + 1rem); right: calc(env(safe-area-inset-right, 0px) + 1rem);">
    <button data-action="click->video-player#toggleSourceInfo" data-video-player-target="sourceToggle" class="px-2 py-1 bg-black/60 rounded text-xs text-sv-text-muted hover:text-white transition-colors">
      Stream info
    </button>
    <div data-video-player-target="sourceDetails" class="hidden mt-2 p-3 bg-black/80 rounded-lg text-xs text-sv-text-muted space-y-1 break-all">
      <p><span class="text-sv-text">Source:</span> <span data-video-player-target="sourceUrl"></span></p>
      <p><span class="text-sv-text">File:</span> <span data-video-player-target="sourceFilename"></span></p>
    </div>
  </div>

  <%# Video element — no native controls, custom UI below %>
  <video data-video-player-target="video" id="stream-player"
         playsinline
         class="w-full h-full"
         style="object-fit: contain; background: #000;">
  </video>

  <div data-video-player-target="subtitleOverlay"
       class="hidden pointer-events-none absolute left-1/2 z-20 max-w-3xl -translate-x-1/2 px-4 py-2 rounded-lg bg-black/60 text-center text-lg font-semibold text-white"
       style="bottom: 6.5rem; white-space: pre-line; text-shadow: 0 2px 8px rgba(0,0,0,0.95);"></div>

  <%# Initial playback overlay (hidden once media actually starts playing) %>
  <div data-video-player-target="startupOverlay"
       class="absolute inset-0 z-30 flex items-center justify-center bg-black/80 transition-opacity duration-200"
       role="status"
       aria-live="polite"
       aria-hidden="false">
    <div class="max-w-sm rounded-xl border border-sv-border bg-sv-surface px-6 py-5 shadow-xl">
      <div data-video-player-target="startupStatus" class="flex flex-col items-center gap-3">
        <div class="w-12 h-12 border-4 border-white/20 border-t-iris-500 rounded-full animate-spin"></div>
        <span class="text-white text-sm font-medium">Starting playback</span>
        <span class="text-sv-text-muted text-xs">Preparing stream...</span>
      </div>

      <div data-video-player-target="autoplayGuidance" class="hidden">
        <h2 id="safari-autoplay-title" class="text-lg font-semibold text-white">Allow automatic playback</h2>
        <p class="mt-2 text-sm leading-6 text-sv-text-muted">
          Safari blocked video with sound. To start future streams automatically:
        </p>
        <ol class="mt-4 space-y-3 text-sm text-sv-text">
          <li class="flex gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-iris-500/20 text-xs font-semibold text-iris-300">1</span>
            <span>Open <strong class="font-medium text-white">Safari → Settings for This Website…</strong></span>
          </li>
          <li class="flex gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-iris-500/20 text-xs font-semibold text-iris-300">2</span>
            <span>Set <strong class="font-medium text-white">Auto-Play</strong> to <strong class="font-medium text-white">Allow All Auto-Play</strong></span>
          </li>
        </ol>
        <p class="mt-4 text-xs leading-5 text-sv-text-muted">Safari controls this permission; StreamVault cannot change it for you.</p>
        <button type="button"
                data-video-player-target="autoplayPlayButton"
                class="mt-5 w-full rounded-lg bg-iris-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-iris-500 focus:outline-none focus:ring-2 focus:ring-iris-300 focus:ring-offset-2 focus:ring-offset-sv-surface">
          Play now
        </button>
      </div>
    </div>
  </div>

  <%# Custom controls bar %>
  <% if @type == "show" %>
    <div data-video-player-target="nextEpisodePrompt"
         class="hidden absolute z-10 max-w-xs text-right"
         style="bottom: calc(env(safe-area-inset-bottom, 0px) + 9rem); right: calc(env(safe-area-inset-right, 0px) + 1rem);">
      <p data-video-player-target="nextEpisodeLabel"
         class="mb-2 truncate text-[11px] font-semibold uppercase tracking-[0.14em] text-white/70"></p>
      <button type="button" data-video-player-target="nextEpisodeButton"
              data-action="click->video-player#skipToNextEpisode"
              class="min-h-11 rounded-lg border border-white/20 bg-black/80 px-4 py-3 text-sm font-semibold text-white shadow-lg transition-colors hover:bg-iris-600 focus:outline-none focus:ring-2 focus:ring-iris-300 focus:ring-offset-2 focus:ring-offset-black disabled:cursor-wait disabled:opacity-70">
        Skip to the next episode
      </button>
      <p data-video-player-target="nextEpisodeStatus" role="status" aria-live="polite"
         class="mt-2 rounded bg-black/80 px-2 text-sm text-white"></p>
    </div>
  <% end %>

  <div data-video-player-target="controls"
       class="absolute bottom-0 left-0 right-0 z-10 bg-gradient-to-t from-black/90 via-black/50 to-transparent pt-16 pb-3 px-4 opacity-100 transition-opacity duration-500"
       style="padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 0.75rem); padding-left: calc(env(safe-area-inset-left, 0px) + 1rem); padding-right: calc(env(safe-area-inset-right, 0px) + 1rem);">

    <%# Seek bar %>
    <div data-video-player-target="seekBar"
         data-action="click->video-player#seek mousedown->video-player#startSeekDrag mouseup->video-player#stopSeekDrag mouseleave->video-player#stopSeekDrag touchstart->video-player#startSeekDrag touchend->video-player#stopSeekDrag"
         class="group relative h-1.5 bg-white/20 rounded-full cursor-pointer mb-3 hover:h-2.5 transition-all">
      <div data-video-player-target="seekBuffered" class="absolute inset-y-0 bg-white/30 rounded-full" style="left: 0%; width: 0%"></div>
      <div data-video-player-target="seekFilled" class="absolute inset-y-0 left-0 bg-iris-500 rounded-full" style="width: 0%"></div>
      <div data-video-player-target="seekHandle" class="absolute w-3 h-3 bg-white rounded-full shadow opacity-0 group-hover:opacity-100 transition-opacity" style="left: 0%; top: 50%; transform: translate(-50%, -50%)"></div>
    </div>

    <%# Controls row %>
    <div class="flex items-center gap-3 text-white text-sm">
      <%# Skip back 10s %>
      <button type="button" data-action="click->video-player#seekBy" data-seek-offset="-10"
              class="relative flex h-9 w-9 shrink-0 items-center justify-center text-white transition-colors hover:text-indigo-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/60"
              aria-label="Back 10 seconds">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.5 12a8.5 8.5 0 1 0 2.8-6.3"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.4 3.8v5h5"/>
        </svg>
        <span class="pointer-events-none absolute text-[9px] font-bold leading-none">10</span>
      </button>

      <%# Play/pause %>
      <button data-action="click->video-player#togglePlay" data-video-player-target="playButton" class="shrink-0 hover:text-iris-400 transition-colors" aria-label="Play or pause">        <svg data-video-player-target="playIcon" class="w-6 h-6 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        <svg data-video-player-target="pauseIcon" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
      </button>

      <%# Skip forward 10s %>
      <button type="button" data-action="click->video-player#seekBy" data-seek-offset="10"
              class="relative flex h-9 w-9 shrink-0 items-center justify-center text-white transition-colors hover:text-indigo-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/60"
              aria-label="Forward 10 seconds">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.5 12a8.5 8.5 0 1 1-2.8-6.3"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.6 3.8v5h-5"/>
        </svg>
        <span class="pointer-events-none absolute text-[9px] font-bold leading-none">10</span>
      </button>

      <%# Time display %>
      <span data-video-player-target="currentTime" class="tabular-nums"><%= player_time(@resume_at) %></span>
      <span class="text-white/40">/</span>
      <span data-video-player-target="durationDisplay" class="text-white/60 tabular-nums"><%= @duration.to_f.positive? ? player_time(@duration) : "--:--" %></span>

      <div class="flex-1"></div>

      <%# Playback speed %>
      <div data-video-player-target="speedControls" class="relative">
        <button type="button" data-action="click->video-player#toggleSpeedMenu"
                class="rounded px-2 py-1 text-xs font-semibold tabular-nums text-white/85 transition-colors hover:bg-white/10 hover:text-white"
                aria-label="Playback speed" aria-haspopup="true">
          <span data-video-player-target="speedButtonLabel">1×</span>
        </button>
        <div data-video-player-target="speedMenu" role="menu"
             class="hidden absolute z-20 space-y-0.5 rounded-lg border border-white/20 bg-black/85 p-1.5 text-xs text-white/85"
             style="right: 0; bottom: 2.25rem; min-width: 6.5rem;">
          <% [0.5, 0.75, 1, 1.25, 1.5, 1.75, 2].each do |rate| %>
            <button type="button" role="menuitemradio" data-action="click->video-player#selectSpeed"
                    data-speed="<%= rate %>" data-video-player-speed="<%= rate %>"
                    class="block w-full rounded px-2 py-1.5 text-left tabular-nums transition-colors hover:bg-white/10">
              <%= rate %>×
            </button>
          <% end %>
        </div>
      </div>

      <%# Volume %>
      <button data-action="click->video-player#toggleMute" class="hover:text-iris-400 transition-colors" aria-label="Mute or unmute">        <svg data-video-player-target="volumeIcon" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/></svg>
        <svg data-video-player-target="muteIcon" class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>
      </button>

      <%# Audio tracks %>
      <div data-video-player-target="audioControls" class="hidden relative">
        <button type="button"
                data-action="click->video-player#toggleAudioMenu"
                class="px-2 py-1 bg-black/60 rounded text-xs text-sv-text-muted hover:text-white transition-colors">
          <span data-video-player-target="audioButtonLabel">Audio</span>
        </button>
        <div data-video-player-target="audioMenu"
             class="hidden absolute z-20 p-2 bg-black/80 rounded-lg text-xs text-sv-text-muted space-y-1 border border-white/20"
             style="right: 0; bottom: 2rem; min-width: 14rem; max-height: 14rem; overflow-y: auto;">
          <div data-video-player-target="audioOptions"></div>
        </div>
      </div>

      <%# Subtitle tracks %>
      <div data-video-player-target="subtitleControls" class="hidden relative">
        <button type="button"
                data-action="click->video-player#toggleSubtitleMenu"
                class="px-2 py-1 bg-black/60 rounded text-xs text-sv-text-muted hover:text-white transition-colors">
          <span data-video-player-target="subtitleButtonLabel">CC</span>
        </button>
        <div data-video-player-target="subtitleMenu"
             class="hidden absolute z-20 p-2 bg-black/80 rounded-lg text-xs text-sv-text-muted space-y-1 border border-white/20"
             style="right: 0; bottom: 2rem; min-width: 14rem; max-height: 14rem; overflow-y: auto;">
          <div data-video-player-target="subtitleOptions"></div>
        </div>
      </div>

      <%# Fullscreen %>
      <button data-action="click->video-player#toggleFullscreen" class="hover:text-iris-400 transition-colors">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
      </button>
    </div>
  </div>

  <%# Loading overlay (shown while ffmpeg restarts after a seek, subtitles catch up, or the stream buffers). bg-black/80 so the spinner is visible — with MSE, when the buffer runs dry Chrome shows black, not a frozen frame, so a transparent overlay would be invisible. %>
  <div data-video-player-target="seekingOverlay" class="hidden absolute inset-0 flex items-center justify-center bg-black/80 z-20">
    <div class="flex flex-col items-center gap-4">
      <div class="w-14 h-14 border-4 border-white/20 border-t-iris-500 rounded-full animate-spin"></div>
      <span data-video-player-target="seekingOverlayMessage" class="text-white text-sm font-medium" style="text-shadow: 0 2px 8px rgba(0,0,0,0.95);">Seeking...</span>
    </div>
  </div>

</div>
