<%
  poster_url = item.respond_to?(:poster_url) ? item.poster_url : item[:poster_url]
  title = item.respond_to?(:title) ? item.title : item[:title]
  year = item.respond_to?(:year) ? item.year : item[:year]
  imdb_id = item.respond_to?(:imdb_id) ? item.imdb_id : item[:imdb_id]
  subtitle = local_assigns.fetch(:subtitle, year)
  progress = local_assigns.fetch(:progress, 0).to_i
  controls = local_assigns[:controls]
  remove_path = local_assigns[:remove_path]
  remove_method = local_assigns.fetch(:remove_method, :patch)
  remove_params = local_assigns[:remove_params]
  remove_label = local_assigns.fetch(:remove_label, "Remove #{title}")
  play_label = local_assigns.fetch(:play_label, "Open #{title}")
  priority = local_assigns.fetch(:priority, false)
  watch_path = local_assigns[:watch_path]
  watch_params = local_assigns.fetch(:watch_params, {})
  watched = local_assigns.fetch(:watched, false)
%>
<article class="poster-card group">
  <%= link_to link_path, class: "block", data: { page_loader: "link" }, aria: { label: play_label } do %>
    <div class="poster-card__art <%= 'poster-card__art--fallback' if poster_url.blank? %>">
      <% if poster_url.present? %>
        <img src="<%= poster_url_for(poster_url) %>" alt="<%= title %>"
             <% if priority %>loading="eager" fetchpriority="high"<% else %>loading="lazy"<% end %>
             decoding="async">
      <% else %>
        <span class="poster-card__initial" aria-hidden="true"><%= title.to_s[0].to_s.upcase %></span>
      <% end %>
      <span class="poster-card__scrim" aria-hidden="true"></span>
      <span class="poster-card__play" aria-hidden="true"><%= icon :play %></span>
      <% if progress.positive? %>
        <div class="card-progress" role="img" aria-label="<%= progress %>% watched">
          <div class="card-progress-bar" style="width: <%= progress %>%"></div>
        </div>
      <% end %>
    </div>
    <div class="poster-card__meta">
      <h3 class="poster-card__title" title="<%= title %>"><%= title %></h3>
      <% if subtitle.present? %>
        <p class="poster-card__sub"><%= subtitle %></p>
      <% end %>
    </div>
  <% end %>

  <% if controls.present? || remove_path.present? || watch_path.present? %>
    <div class="poster-card__controls">
      <% if watch_path.present? %>
        <%= button_to watch_path, method: :patch, params: watch_params,
                      class: "card-action #{'card-action--active' if watched}",
                      title: watched ? "Mark #{title} unwatched" : "Mark #{title} watched",
                      aria: { label: watched ? "Mark #{title} unwatched" : "Mark #{title} watched", pressed: watched } do %>
          <%= icon :check %>
        <% end %>
      <% end %>
      <% if controls == :wishlist %>
        <%= button_to collection_path, method: :patch, params: { state: "library", collection_entry: { imdb_id: imdb_id } }, class: "card-action", title: "Move to library", aria: { label: "Move #{title} to library" } do %>
          <%= icon :library %>
        <% end %>
      <% end %>
      <% if controls.present? %>
        <%= button_to collection_path, method: :patch, params: { state: "none", collection_entry: { imdb_id: imdb_id } }, class: "card-action card-action--danger", title: "Remove", aria: { label: "Remove #{title} from #{controls}" } do %>
          <%= icon :x %>
        <% end %>
      <% end %>
      <% if remove_path.present? %>
        <%= button_to remove_path, method: remove_method, params: remove_params, class: "card-action card-action--danger", title: "Remove", aria: { label: remove_label } do %>
          <%= icon :x %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</article>
