<% if pagination.total_pages > 1 %>
  <% query = request.query_parameters.except("page", "per_page") %>
  <nav class="pagination" aria-label="<%= label %> pagination">
    <% if pagination.page > 1 %>
      <%= link_to url_for(query.merge(page: pagination.page - 1, per_page: pagination.per_page)), class: "pagination__link", aria: { label: "Previous page" } do %>
        <span class="inline-flex items-center gap-1.5"><%= icon :chevron_left, css: "w-3.5 h-3.5" %> Previous</span>
      <% end %>
    <% end %>

    <% previous_page = 0 %>
    <% pagination.visible_pages.each do |page| %>
      <% if page - previous_page > 1 %>
        <span class="pagination__gap" aria-hidden="true">&hellip;</span>
      <% end %>
      <% if page == pagination.page %>
        <span class="pagination__page" aria-current="page"><%= page %></span>
      <% else %>
        <%= link_to page, url_for(query.merge(page: page, per_page: pagination.per_page)), class: "pagination__page", aria: { label: "Page #{page}" } %>
      <% end %>
      <% previous_page = page %>
    <% end %>

    <% if pagination.page < pagination.total_pages %>
      <%= link_to url_for(query.merge(page: pagination.page + 1, per_page: pagination.per_page)), class: "pagination__link", aria: { label: "Next page" } do %>
        <span class="inline-flex items-center gap-1.5">Next <%= icon :chevron_right, css: "w-3.5 h-3.5" %></span>
      <% end %>
    <% end %>
  </nav>
<% end %>
