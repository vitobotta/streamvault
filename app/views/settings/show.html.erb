<div class="mb-8 md:mb-10">
  <p class="kicker mb-2.5">Preferences</p>
  <h1 class="t-page">Settings</h1>
  <p class="mt-2 text-sm text-ink-400">Signed in as <span class="text-ink-200"><%= @user.email %></span></p>
</div>

<div class="grid gap-10 lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-14">
  <nav class="hidden lg:block" aria-label="Settings sections" data-controller="settings-nav">
    <div class="sticky top-8 space-y-0.5">
      <a href="#account" class="settings-nav" data-settings-nav-target="link" data-section="account">Account</a>
      <a href="#streaming" class="settings-nav" data-settings-nav-target="link" data-section="streaming">Debrid</a>
      <a href="#child" class="settings-nav" data-settings-nav-target="link" data-section="child">Child account</a>
      <a href="#languages" class="settings-nav" data-settings-nav-target="link" data-section="languages">Languages</a>
    </div>
  </nav>

  <div class="max-w-3xl min-w-0">
    <%= form_with model: @user, url: settings_path, method: :patch, class: "space-y-5" do |f| %>
      <% if @user.errors.any? %>
        <div class="flash-alert">
          <ul class="list-disc list-inside space-y-0.5">
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <section id="account" class="panel panel-pad anchor-offset">
        <div class="mb-6">
          <h2 class="t-section mb-1.5">Account</h2>
          <p class="text-xs text-ink-400">Your sign-in details for this StreamVault profile.</p>
        </div>

        <div>
          <span class="field-label">Email</span>
          <p class="text-sm text-ink-100"><%= @user.email %></p>
          <p class="field-hint">Email addresses cannot be changed in the app.</p>
        </div>

        <div class="mt-7 border-t border-white/8 pt-6">
          <h3 class="text-sm font-medium text-ink-100 mb-4">Change password</h3>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <%= f.label :current_password, "Current password", class: "field-label" %>
              <%= f.password_field :current_password, class: "input-field", autocomplete: "current-password" %>
            </div>
            <div>
              <%= f.label :password, "New password", class: "field-label" %>
              <%= f.password_field :password, class: "input-field", autocomplete: "new-password", placeholder: "Leave blank to keep" %>
            </div>
            <div>
              <%= f.label :password_confirmation, "Confirm new password", class: "field-label" %>
              <%= f.password_field :password_confirmation, class: "input-field", autocomplete: "new-password" %>
            </div>
          </div>
        </div>
      </section>

      <section id="streaming" class="panel panel-pad anchor-offset">
        <div class="flex flex-wrap items-start justify-between gap-3 mb-6">
          <div>
            <h2 class="t-section mb-1.5">Debrid</h2>
            <p class="text-xs text-ink-400">Pick the debrid service you prefer; its streams are listed first. When keys for both services are available, both are queried and their streams merged, so you get more results to choose from. Your own API key takes precedence; if you leave it blank, the team key set by an administrator (or in the environment) is used.</p>
          </div>
          <% if @user.debrid_credentials.any? %>
            <span class="chip chip--sage"><%= icon :check, css: "w-3 h-3" %> Key saved</span>
          <% else %>
            <span class="chip chip--accent">Not configured</span>
          <% end %>
        </div>

        <div class="mb-7 max-w-xs">
          <%= f.label :debrid_service, "Preferred service", class: "field-label" %>
          <%= f.select :debrid_service,
            options_for_select(User::DEBRID_SERVICES.map { |value, label| [ label, value ] }, @user.effective_debrid_service),
            {},
            class: "input-field" %>
        </div>

        <div class="border-t border-white/8 pt-6">
          <%= f.label :realdebrid_api_key, "RealDebrid API key", class: "field-label" %>
          <%= f.password_field :realdebrid_api_key, class: "input-field", placeholder: @user.has_realdebrid_key? ? "Enter a new key to replace the saved one" : "Paste your RealDebrid API key", value: "" %>
          <p class="field-hint">
            Create a key at
            <a href="https://real-debrid.com/apitoken" target="_blank" rel="noopener" class="text-iris-300 underline underline-offset-2">real-debrid.com/apitoken</a>.
          </p>
          <% if @user.realdebrid_api_key.present? %>
            <label class="mt-3 flex items-center gap-2 text-xs text-ink-400">
              <%= check_box_tag "user[clear_realdebrid_api_key]", "1", false, class: "rounded" %>
              Remove my key and use the shared key instead
            </label>
          <% elsif @user.effective_realdebrid_api_key.present? %>
            <p class="mt-2 text-xs text-ink-400">Using the team RealDebrid key.</p>
          <% else %>
            <p class="mt-2 text-xs text-ink-400">No RealDebrid key configured.</p>
          <% end %>
        </div>

        <div class="mt-7 border-t border-white/8 pt-6">
          <%= f.label :torbox_api_key, "TorBox API key", class: "field-label" %>
          <%= f.password_field :torbox_api_key, class: "input-field", placeholder: @user.has_torbox_key? ? "Enter a new key to replace the saved one" : "Paste your TorBox API key", value: "" %>
          <p class="field-hint">
            Create a key at
            <a href="https://torbox.app/settings" target="_blank" rel="noopener" class="text-iris-300 underline underline-offset-2">torbox.app/settings</a>.
          </p>
          <% if @user.torbox_api_key.present? %>
            <label class="mt-3 flex items-center gap-2 text-xs text-ink-400">
              <%= check_box_tag "user[clear_torbox_api_key]", "1", false, class: "rounded" %>
              Remove my key and use the shared key instead
            </label>
          <% elsif @user.effective_torbox_api_key.present? %>
            <p class="mt-2 text-xs text-ink-400">Using the team TorBox key.</p>
          <% else %>
            <p class="mt-2 text-xs text-ink-400">No TorBox key configured.</p>
          <% end %>
        </div>

        <div class="mt-7 border-t border-white/8 pt-6 text-xs text-ink-400">
          Preferred service: <span class="text-ink-100"><%= @user.debrid_service_label %></span>.
          <% extra = @user.debrid_credentials.map(&:first) - [ @user.effective_debrid_service ] %>
          <% if extra.any? %>
            Streams from <%= extra.map { |service| User::DEBRID_SERVICES.fetch(service, service) }.to_sentence %> are merged in.
          <% end %>
          <% source = @user.debrid_key_source %>
          <% if source == :user %>
            Using your own key.
          <% elsif source == :global %>
            Using the administrator's team key.
          <% elsif source == :environment %>
            Using the installation key from the environment.
          <% else %>
            No key available for this service.
          <% end %>
          <% if @user.admin? %>
            <div class="mt-2"><%= link_to "Manage team keys", admin_settings_path, class: "text-iris-300 underline underline-offset-2" %></div>
          <% end %>
        </div>
      </section>

      <section id="child" class="panel panel-pad anchor-offset">
        <div class="mb-6">
          <h2 class="t-section mb-1.5">Child account</h2>
          <p class="text-xs text-ink-400 leading-relaxed max-w-xl">
            Restrict this profile to age-rated titles. Search, browsing and playback all honour the limit, including direct links.
            Turning child status off, or changing the age, requires the child lock password.
          </p>
        </div>

        <label class="switch mb-6" for="user_child_account">
          <%= f.check_box :child_account, class: "switch__input" %>
          <span class="switch__track" aria-hidden="true"><span class="switch__thumb"></span></span>
          <span class="text-sm font-medium text-ink-100">This is a child account</span>
        </label>

        <div class="mb-6 max-w-xs">
          <%= f.label :max_rating_age, "Maximum rating age", class: "field-label" %>
          <%= f.select :max_rating_age,
            options_for_select(User::MAX_RATING_AGE_OPTIONS, @user.max_rating_age),
            { include_blank: "Select an age limit" },
            class: "input-field" %>
          <p class="field-hint">Titles rated above this age are hidden and blocked. Unrated titles need the 18+ limit.</p>
        </div>

        <div class="border-t border-white/8 pt-6">
          <h3 class="text-sm font-medium text-ink-100 mb-1">Child lock password</h3>
          <p class="text-xs text-ink-400 mb-4">Set once, then required to change the settings above.</p>
          <div class="grid gap-4 sm:grid-cols-2">
            <% if @user.child_lock_set? %>
              <div class="sm:col-span-2">
                <%= f.label :child_lock_current_password, "Current child lock password", class: "field-label" %>
                <%= f.password_field :child_lock_current_password, class: "input-field", autocomplete: "off", placeholder: "Required to turn child status off or change the age limit" %>
              </div>
            <% end %>
            <div>
              <%= f.label :child_lock_password, (@user.child_lock_set? ? "New child lock password" : "Child lock password"), class: "field-label" %>
              <%= f.password_field :child_lock_password, class: "input-field", autocomplete: "new-password", placeholder: (@user.child_lock_set? ? "Leave blank to keep current" : "At least 4 characters") %>
            </div>
            <div>
              <%= f.label :child_lock_password_confirmation, "Confirm password", class: "field-label" %>
              <%= f.password_field :child_lock_password_confirmation, class: "input-field", autocomplete: "new-password" %>
            </div>
          </div>
        </div>
      </section>

      <section id="languages" class="panel panel-pad anchor-offset">
        <div class="mb-6">
          <h2 class="t-section mb-1.5">Languages</h2>
          <p class="text-xs text-ink-400">Pick the languages you accept in stream releases, then set the audio language streams should start in.</p>
        </div>

        <div class="flex flex-wrap gap-2 mb-6" data-controller="language-picker">
          <% User::STREAM_LANGUAGE_OPTIONS.each do |code, name| %>
            <% selected = Array(@user.preferred_languages).include?(code) %>
            <label class="lang-pill"
                   data-language-picker-target="pill"
                   data-code="<%= code %>"
                   data-selected="<%= selected %>"
                   style="<%= selected ? 'background-color: var(--color-iris-600); color: var(--color-on-accent);' : 'background-color: oklch(1 0 0 / 0.05); color: var(--color-ink-300);' %>">
              <input type="checkbox" name="user[preferred_languages][]" value="<%= code %>" <%= 'checked' if selected %> class="sr-only">
              <span><%= name %></span>
            </label>
          <% end %>
        </div>
        <input type="hidden" name="user[preferred_languages][]" value="">

        <div class="max-w-xs">
          <%= f.label :default_language, "Default audio language", class: "field-label" %>
          <%= f.select :default_language,
            options_for_select(
              Array(@user.preferred_languages).map { |c| [User::STREAM_LANGUAGE_OPTIONS[c], c] },
              @user.default_language
            ),
            {},
            class: "input-field" %>
        </div>
      </section>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <%= f.submit "Save changes", class: "btn-primary cursor-pointer" %>
        <p class="text-xs text-ink-400">Changes apply to this account immediately.</p>
      </div>
    <% end %>
  </div>
</div>
