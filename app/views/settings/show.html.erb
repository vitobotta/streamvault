<div class="px-6 py-8 max-w-2xl">
  <h1 class="text-3xl font-bold text-white mb-8">Settings</h1>

  <%= form_with model: @user, url: settings_path, method: :patch, class: "space-y-6" do |f| %>
    <% if @user.errors.any? %>
      <div class="bg-red-900/20 border border-red-800/40 rounded-lg p-4">
        <ul class="list-disc list-inside text-sm text-red-300">
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="bg-sv-surface rounded-xl p-6 border border-sv-border">
      <h2 class="text-lg font-semibold text-white mb-4">Account</h2>

      <div class="mb-4">
        <label class="block text-sm font-medium text-sv-text-muted mb-1.5">Email</label>
        <input type="email" value="<%= @user.email %>" class="input-field" disabled>
      </div>

      <div class="border-t border-sv-border pt-4">
        <h3 class="text-sm font-medium text-white mb-3">Change Password</h3>
        <div class="space-y-3">
          <div>
            <%= f.label :current_password, "Current Password", class: "block text-sm font-medium text-sv-text-muted mb-1.5" %>
            <%= f.password_field :current_password, class: "input-field", autocomplete: "current-password" %>
          </div>
          <div>
            <%= f.label :password, "New Password", class: "block text-sm font-medium text-sv-text-muted mb-1.5" %>
            <%= f.password_field :password, class: "input-field", autocomplete: "new-password", placeholder: "Leave blank to keep current" %>
          </div>
          <div>
            <%= f.label :password_confirmation, "Confirm New Password", class: "block text-sm font-medium text-sv-text-muted mb-1.5" %>
            <%= f.password_field :password_confirmation, class: "input-field", autocomplete: "new-password" %>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-sv-surface rounded-xl p-6 border border-sv-border">
      <h2 class="text-lg font-semibold text-white mb-2">Debrid</h2>
      <p class="text-xs text-sv-text-muted mb-4">Pick the debrid service you prefer; its streams are listed first. When keys for both services are available, both are queried and their streams merged, so you get more results to choose from. Your own API key takes precedence; if you leave it blank, the team key set by an administrator (or in the environment) is used.</p>

      <div class="mb-4">
        <%= f.label :debrid_service, "Preferred service", class: "block text-sm font-medium text-sv-text-muted mb-1.5" %>
        <%= f.select :debrid_service,
          options_for_select(User::DEBRID_SERVICES.map { |value, label| [ label, value ] }, @user.effective_debrid_service),
          {},
          class: "input-field w-auto" %>
      </div>

      <div class="mb-4">
        <%= f.label :realdebrid_api_key, "RealDebrid API key", class: "block text-sm font-medium text-sv-text-muted mb-1.5" %>
        <%= f.password_field :realdebrid_api_key, class: "input-field", placeholder: "Enter your RealDebrid API key", value: "" %>
        <p class="text-xs text-sv-text-muted mt-1">Get your API key from <a href="https://real-debrid.com/apitoken" target="_blank" class="text-sv-accent">real-debrid.com/apitoken</a></p>
        <% if @user.realdebrid_api_key.present? %>
          <p class="mt-2 text-xs text-sv-success">Your RealDebrid key is saved.</p>
          <label class="mt-2 flex items-center gap-2 text-xs text-sv-text-muted">
            <%= check_box_tag "user[clear_realdebrid_api_key]", "1", false, class: "rounded" %>
            Remove my key and use the shared key instead
          </label>
        <% elsif @user.effective_realdebrid_api_key.present? %>
          <p class="mt-2 text-xs text-sv-text-muted">Using the team RealDebrid key.</p>
        <% else %>
          <p class="mt-2 text-xs text-sv-text-muted">No RealDebrid key configured.</p>
        <% end %>
      </div>

      <div>
        <%= f.label :torbox_api_key, "TorBox API key", class: "block text-sm font-medium text-sv-text-muted mb-1.5" %>
        <%= f.password_field :torbox_api_key, class: "input-field", placeholder: "Enter your TorBox API key", value: "" %>
        <p class="text-xs text-sv-text-muted mt-1">Get your API key from <a href="https://torbox.app/settings" target="_blank" class="text-sv-accent">torbox.app/settings</a></p>
        <% if @user.torbox_api_key.present? %>
          <p class="mt-2 text-xs text-sv-success">Your TorBox key is saved.</p>
          <label class="mt-2 flex items-center gap-2 text-xs text-sv-text-muted">
            <%= check_box_tag "user[clear_torbox_api_key]", "1", false, class: "rounded" %>
            Remove my key and use the shared key instead
          </label>
        <% elsif @user.effective_torbox_api_key.present? %>
          <p class="mt-2 text-xs text-sv-text-muted">Using the team TorBox key.</p>
        <% else %>
          <p class="mt-2 text-xs text-sv-text-muted">No TorBox key configured.</p>
        <% end %>
      </div>

      <div class="mt-4 border-t border-sv-border pt-4 text-xs text-sv-text-muted">
        Preferred service: <span class="text-white"><%= @user.debrid_service_label %></span>.
        <% extra = @user.debrid_credentials.map(&:first) - [ @user.effective_debrid_service ] %>
        <% if extra.any? %>
          Streams from <%= extra.map { |service| User::DEBRID_SERVICES.fetch(service, service) }.to_sentence %> are merged in.
        <% end %>
        <% source = @user.debrid_key_source %>
        <% if source == :user %>
          Using your own key.
        <% elsif source == :global %>
          Using the administrator's team key.
        <% elsif source == :environment %>
          Using the installation key from the environment.
        <% else %>
          No key available for this service.
        <% end %>
        <% if @user.admin? %>
          <div class="mt-2"><%= link_to "Manage team keys", admin_settings_path, class: "text-sv-accent" %></div>
        <% end %>
      </div>
    </div>

    <div class="bg-sv-surface rounded-xl p-6 border border-sv-border">
      <h2 class="text-lg font-semibold text-white mb-2">Child Account</h2>
      <p class="text-xs text-sv-text-muted mb-4">Restrict this account to age-rated content. Search and browsing only return titles rated for the selected age, and anything above the limit cannot be opened or played even by direct URL. A child lock password is required to turn child status off or change the age limit later.</p>

      <div class="flex items-center gap-2 mb-4">
        <%= f.check_box :child_account, class: "rounded" %>
        <%= f.label :child_account, "This is a child account", class: "text-sm font-medium text-white" %>
      </div>

      <div class="mb-4">
        <%= f.label :max_rating_age, "Maximum rating age", class: "block text-sm font-medium text-sv-text-muted mb-1.5" %>
        <%= f.select :max_rating_age,
          options_for_select(User::MAX_RATING_AGE_OPTIONS, @user.max_rating_age),
          { include_blank: "Select an age limit" },
          class: "input-field w-auto" %>
        <p class="text-xs text-sv-text-muted mt-1">Titles whose rating is meant for viewers older than this are hidden and blocked. Unrated titles require the 18+ limit.</p>
      </div>

      <div class="border-t border-sv-border pt-4 space-y-3">
        <h3 class="text-sm font-medium text-white">Child Lock Password</h3>
        <% if @user.child_lock_set? %>
          <div>
            <%= f.label :child_lock_current_password, "Current Child Lock Password", class: "block text-sm font-medium text-sv-text-muted mb-1.5" %>
            <%= f.password_field :child_lock_current_password, class: "input-field", autocomplete: "off", placeholder: "Required to turn child status off or change the age limit" %>
          </div>
        <% end %>
        <div>
          <%= f.label :child_lock_password, (@user.child_lock_set? ? "New Child Lock Password" : "Child Lock Password"), class: "block text-sm font-medium text-sv-text-muted mb-1.5" %>
          <%= f.password_field :child_lock_password, class: "input-field", autocomplete: "new-password", placeholder: (@user.child_lock_set? ? "Leave blank to keep current" : "Required to enable child status") %>
        </div>
        <div>
          <%= f.label :child_lock_password_confirmation, "Confirm Child Lock Password", class: "block text-sm font-medium text-sv-text-muted mb-1.5" %>
          <%= f.password_field :child_lock_password_confirmation, class: "input-field", autocomplete: "new-password" %>
        </div>
      </div>
    </div>

    <div class="bg-sv-surface rounded-xl p-6 border border-sv-border">
      <h2 class="text-lg font-semibold text-white mb-2">Preferred Languages</h2>
      <p class="text-xs text-sv-text-muted mb-4">Select at least one language. Streams without at least one of your selected languages will be filtered out.</p>

      <div class="flex flex-wrap gap-2 mb-4" data-controller="language-picker">
        <% User::STREAM_LANGUAGE_OPTIONS.each do |code, name| %>
          <% selected = Array(@user.preferred_languages).include?(code) %>
          <label class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm cursor-pointer transition-colors"
                 data-language-picker-target="pill"
                 data-code="<%= code %>"
                 data-selected="<%= selected %>"
                 style="<%= selected ? 'background-color: var(--color-sv-accent); color: white;' : 'background-color: var(--color-sv-surface-hover); color: var(--color-sv-text-muted);' %>">
            <input type="checkbox" name="user[preferred_languages][]" value="<%= code %>" <%= 'checked' if selected %> class="hidden">
            <span><%= name %></span>
          </label>
        <% end %>
      </div>
      <input type="hidden" name="user[preferred_languages][]" value="">
    </div>

    <div class="bg-sv-surface rounded-xl p-6 border border-sv-border">
      <h2 class="text-lg font-semibold text-white mb-2">Default Language</h2>
      <p class="text-xs text-sv-text-muted mb-4">Default audio language when starting a stream.</p>

      <%= f.select :default_language,
        options_for_select(
          Array(@user.preferred_languages).map { |c| [User::STREAM_LANGUAGE_OPTIONS[c], c] },
          @user.default_language
        ),
        {},
        class: "input-field w-auto"
      %>
    </div>

    <%= f.submit "Save Settings", class: "btn-primary cursor-pointer" %>
  <% end %>
</div>
