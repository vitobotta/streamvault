<% if @streams_error.present? %>
  <p class="text-sm text-gold-400"><%= @streams_error %></p>
<% elsif @streams.present? %>
  <%
    episode_play_params = {
      imdb_id: @imdb_id,
      type: "show",
      season: @season,
      episode: @episode,
      title: @episode_label,
      poster_url: @poster_url,
      duration: @episode_duration_seconds
    }
  %>
  <div class="space-y-0.5">
    <% @streams.each do |stream| %>
      <%= render "shared/stream_row", stream: stream, play_params: episode_play_params, button_class: "btn-secondary btn-sm" %>    <% end %>
  </div>
<% else %>
  <p class="text-sm text-ink-400">No releases found for this episode.</p>
<% end %>
