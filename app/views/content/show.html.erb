<%
  # Back link: build it from known internal routes rather than the raw Referer,
  # which is attacker-controlled and would render an off-site link.
  back_target =
    if request.referer&.include?("/search")
      [search_index_path, "Back to search"]
    elsif request.referer&.include?("/library")
      [library_index_path, "Back to library"]
    elsif request.referer&.include?("/wishlist")
      [wishlist_index_path, "Back to wishlist"]
    elsif request.referer&.include?("/watch_history")
      [watch_history_index_path, "Back to history"]
    else
      [root_path, "Back to home"]
    end

  collection_params = if @metadata
    { collection_entry: { content_type: @type, imdb_id: @imdb_id, title: @metadata[:title], poster_url: @metadata[:poster_url], year: @metadata[:year]&.to_i } }.to_query
  end

  # Highest-confidence source: RealDebrid-cached first, then compatibility.
  best_stream = @streams.present? ? @streams.max_by { |s| [s[:rd_plus] ? 1 : 0, s[:compatibility_score].to_i] } : nil
  resume_episode = @type == "show" && !@series_watched ? @episode_progress&.keys&.first : nil
%>

<% if @metadata %>
  <div class="-mx-5 -mt-6 md:-mx-8 md:-mt-8 xl:-mx-12 xl:-mt-10">
    <section class="detail-hero" aria-labelledby="content-title">
      <% if @metadata[:background_url].present? %>
        <img class="detail-hero__bg" src="<%= poster_url_for(@metadata[:background_url]) %>" alt="" aria-hidden="true">
      <% end %>
      <span class="detail-hero__scrim" aria-hidden="true"></span>

      <div class="detail-hero__inner">
        <div class="order-2 md:order-1">
          <div class="detail-poster">
            <% if @metadata[:poster_url].present? %>
              <img src="<%= poster_url_for(@metadata[:poster_url]) %>" alt="<%= @metadata[:title] %> poster">
            <% else %>
              <div class="grid h-full place-items-center bg-ink-850">
                <span class="poster-card__initial"><%= @metadata[:title].to_s[0].to_s.upcase %></span>
              </div>
            <% end %>
          </div>
        </div>

        <div class="order-1 min-w-0 md:order-2">
          <% if back_target %>
            <%= link_to back_target[0], class: "mb-6 inline-flex items-center gap-1.5 text-xs text-ink-300 transition-colors hover:text-ink-50", data: { page_loader: "link" } do %>
              <%= icon :arrow_left, css: "w-3.5 h-3.5" %>
              <%= back_target[1] %>
            <% end %>
          <% end %>

          <p class="kicker mb-3"><%= @type == "show" ? "Series" : "Film" %><%= " · #{@metadata[:year]}" if @metadata[:year].present? %></p>
          <h1 class="t-hero mb-4" id="content-title"><%= @metadata[:title] %></h1>

          <div class="meta-row">
            <% if @metadata[:year].present? %>
              <span class="t-num"><%= @metadata[:year] %></span>
            <% end %>
            <% if @type != "show" && @metadata[:runtime].present? %>
              <span class="meta-dot t-num"><%= @metadata[:runtime] %></span>
            <% end %>
            <% if @metadata[:genre].present? %>
              <span class="meta-dot"><%= @metadata[:genre] %></span>
            <% end %>
            <% if @type == "show" && @metadata[:total_seasons].present? %>
              <span class="meta-dot"><%= @metadata[:total_seasons] %> <%= @metadata[:total_seasons] == 1 ? "season" : "seasons" %></span>
            <% end %>
          </div>

          <% if @metadata[:rated].present? || @metadata[:imdb_rating].present? || @metadata[:rt_rating].present? || @metadata[:metascore].present? %>
            <div class="mt-4 flex flex-wrap items-center gap-1.5">
              <% if @metadata[:rated].present? %>
                <span class="chip"><%= @metadata[:rated] %></span>
              <% end %>
              <% if @metadata[:imdb_rating].present? %>
                <span class="chip chip--gold"><%= icon :star, css: "w-3 h-3" %> IMDb <%= @metadata[:imdb_rating] %></span>
              <% end %>
              <% if @metadata[:rt_rating].present? %>
                <span class="chip">Rotten Tomatoes <%= @metadata[:rt_rating] %></span>
              <% end %>
              <% if @metadata[:metascore].present? %>
                <span class="chip chip--sage">Metascore <%= @metadata[:metascore] %></span>
              <% end %>
            </div>
          <% end %>

          <% if @metadata[:plot].present? %>
            <p class="mt-5 max-w-2xl text-sm leading-6 text-ink-200"><%= @metadata[:plot] %></p>
          <% end %>

          <% if @metadata[:actors].present? %>
            <p class="mt-3 max-w-2xl text-xs leading-5 text-ink-400">
              <span class="text-ink-300">Cast</span> <%= @metadata[:actors] %>
            </p>
          <% end %>

          <div class="mt-7 flex flex-wrap items-center gap-2.5">
            <% if @type != "show" && best_stream.present? %>
              <%= button_to streaming_index_path,
                            params: { imdb_id: @imdb_id, type: @type, title: @metadata[:title], poster_url: @metadata[:poster_url], duration: @metadata[:runtime_seconds], resolve_url: best_stream[:resolve_url], filename: best_stream[:filename], raw_size: best_stream[:raw_size], video_codec: best_stream[:video_codec], compatibility_score: best_stream[:compatibility_score] },
                            class: "btn-primary btn-lg",
                            data: { page_loader: "stream" } do %>
                <%= icon :play, css: "w-4 h-4" %>
                Play
              <% end %>
              <% if @streams.size > 1 %>
                <%= link_to "#sources", class: "btn-ghost btn-lg" do %>
                  All sources
                <% end %>
              <% end %>
            <% elsif @type == "show" && resume_episode %>
              <%= link_to content_path(type: @type, imdb_id: @imdb_id, season: resume_episode[0], anchor: "episode-#{resume_episode[0]}-#{resume_episode[1]}"),
                          class: "btn-primary btn-lg",
                          data: { page_loader: "link" } do %>
                <%= icon :play, css: "w-4 h-4" %>
                Continue S<%= format("%02d", resume_episode[0].to_i) %>E<%= format("%02d", resume_episode[1].to_i) %>
              <% end %>
            <% end %>
          </div>

          <div class="collection-actions mt-3" data-collection-actions>
            <button type="button"
                    class="collection-btn <%= 'collection-btn--active' if @in_library %>"
                    data-controller="toggle-button"
                    data-action="click->toggle-button#toggle"
                    data-toggle-button-state-value="library"
                    data-toggle-button-url-value="<%= collection_path %>"
                    data-toggle-button-active-value="<%= @in_library %>"
                    data-toggle-button-status-url-value="<%= content_status_path(type: @type, imdb_id: @imdb_id) %>"
                    data-toggle-button-params-value="<%= collection_params %>"
                    aria-pressed="<%= @in_library %>"
                    title="<%= @in_library ? 'Remove from library' : 'Add to library' %>">
              <span data-toggle-icon><%= icon(@in_library ? :check : :plus) %></span>
              <span data-toggle-label><%= @in_library ? "In library" : "Library" %></span>
            </button>

            <button type="button"
                    class="collection-btn <%= 'collection-btn--active' if @in_wishlist %>"
                    data-controller="toggle-button"
                    data-action="click->toggle-button#toggle"
                    data-toggle-button-state-value="wishlist"
                    data-toggle-button-url-value="<%= collection_path %>"
                    data-toggle-button-active-value="<%= @in_wishlist %>"
                    data-toggle-button-status-url-value="<%= content_status_path(type: @type, imdb_id: @imdb_id) %>"
                    data-toggle-button-params-value="<%= collection_params %>"
                    aria-pressed="<%= @in_wishlist %>"
                    title="<%= @in_wishlist ? 'Remove from wishlist' : 'Add to wishlist' %>">
              <span data-toggle-icon><%= icon :wishlist %></span>
              <span data-toggle-label><%= @in_wishlist ? "On wishlist" : "Wishlist" %></span>
            </button>

            <% if @type != "show" %>
              <%= button_to content_watched_path(type: @type, imdb_id: @imdb_id),
                            method: :patch,
                            params: { watched: !@movie_watched, title: @metadata[:title], poster_url: @metadata[:poster_url], duration_seconds: @metadata[:runtime_seconds] },
                            class: "collection-btn #{'collection-btn--active' if @movie_watched}",
                            aria: { pressed: @movie_watched },
                            title: @movie_watched ? "Mark this film unwatched" : "Mark this film watched" do %>
                <span><%= icon :check %></span>
                <span><%= @movie_watched ? "Watched" : "Mark watched" %></span>
              <% end %>
            <% end %>

            <% if @type == "show" %>
              <%= button_to content_watched_path(type: @type, imdb_id: @imdb_id),
                            method: :patch,
                            params: { watched: !@series_watched, title: @metadata[:title], poster_url: @metadata[:poster_url] },
                            class: "collection-btn #{'collection-btn--active' if @series_watched}",
                            aria: { pressed: @series_watched },
                            title: @series_watched ? "Mark every episode unwatched" : "Mark every released episode watched" do %>
                <span><%= icon :check %></span>
                <span><%= @series_watched ? "Series watched" : "Mark series watched" %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </section>
  </div>

  <div class="pt-2">
    <%# MOVIES: sources list %>
    <% if @type != "show" %>
      <section class="mt-9" id="sources">
        <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
          <div>
            <p class="kicker mb-2">Play</p>
            <h2 class="t-section">Sources</h2>
          </div>
          <% if @streams.present? %>
            <p class="text-xs text-ink-400"><span class="t-num"><%= @streams.size %></span> <%= @streams.size == 1 ? "release" : "releases" %> found</p>
          <% end %>
        </div>

        <% if @streams_error.present? %>
          <div class="panel panel-pad">
            <p class="text-sm text-gold-400"><%= @streams_error %></p>
            <p class="mt-1.5 text-xs text-ink-400">If this persists, the stream provider may be blocking this server's IP. Consider setting <code class="text-ink-200">TORRENTIO_PROXY</code> or <code class="text-ink-200">TORRENTIO_API_BASE_URL</code>.</p>
          </div>
        <% elsif @streams.present? %>
          <%
            # Cached, best-scoring releases first; the long tail collapses behind a disclosure.
            ordered_streams = @streams.sort_by { |s| [s[:rd_plus] ? 0 : 1, -s[:compatibility_score].to_i] }
            visible_streams = ordered_streams.first(6)
            hidden_streams = ordered_streams.drop(6)
            movie_play_params = { imdb_id: @imdb_id, type: @type, title: @metadata[:title], poster_url: @metadata[:poster_url], duration: @metadata[:runtime_seconds] }
          %>
          <div class="source-list">
            <% visible_streams.each do |stream| %>
              <%= render "shared/stream_row", stream: stream, play_params: movie_play_params %>
            <% end %>
          </div>

          <% if hidden_streams.any? %>
            <details>
              <summary class="source-more">
                <span>Show all <%= @streams.size %> releases</span>
                <%= icon :chevron_down %>
              </summary>
              <div class="source-list">
                <% hidden_streams.each do |stream| %>
                  <%= render "shared/stream_row", stream: stream, play_params: movie_play_params %>
                <% end %>
              </div>
            </details>
          <% end %>
        <% else %>
          <div class="panel panel-pad text-center">
            <p class="text-sm text-ink-200">No releases found for this title.</p>
            <% unless current_user.has_realdebrid_key? %>
              <p class="mt-1.5 text-xs text-ink-400">
                Add your RealDebrid API key in <%= link_to "Settings", settings_path, class: "text-iris-300 underline underline-offset-2" %> to enable streaming.
              </p>
            <% end %>
          </div>
        <% end %>
      </section>
    <% end %>

    <%# SHOWS: seasons + episodes %>
    <% if @type == "show" && @metadata[:episodes].present? %>
      <% seasons = @metadata[:episodes].map { |e| e[:season] }.reject { |s| s == 0 }.uniq.sort %>
      <% season_episodes = @metadata[:episodes].select { |e| e[:season] == @selected_season && e[:season] != 0 } %>
      <section class="mt-9">
        <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
          <div>
            <p class="kicker mb-2">Episodes</p>
            <h2 class="t-section">Season <%= @selected_season %></h2>
          </div>
          <p class="text-xs text-ink-400"><span class="t-num"><%= season_episodes.size %></span> episodes</p>
        </div>

        <div class="season-tabs mb-4" role="group" aria-label="Choose a season">
          <% seasons.each do |s| %>
            <%= link_to content_path(type: @type, imdb_id: @imdb_id, season: s),
                        class: "season-tab #{@selected_season == s ? 'season-tab--active' : ''}",
                        "aria-current": (@selected_season == s ? "true" : nil),
                        data: { page_loader: "link" } do %>
              Season <%= s %>
            <% end %>
          <% end %>
        </div>

        <div class="row-list" data-controller="episode-picker"
             data-episode-picker-url-value="<%= episode_streams_path(type: @type, imdb_id: @imdb_id) %>">
          <% season_episodes.each do |ep| %>
            <% progress = @episode_progress&.dig([ep[:season], ep[:episode]]) %>
            <div class="episode anchor-offset" id="episode-<%= ep[:season] %>-<%= ep[:episode] %>" data-episode-picker-target="episode">
              <button class="episode__button"
                      data-action="click->episode-picker#toggle"
                      data-season="<%= ep[:season] %>"
                      data-episode="<%= ep[:episode] %>"
                      data-title="<%= ep[:title] %>"
                      aria-expanded="false">
                <span class="episode__number"><%= ep[:episode] %></span>
                <span class="episode__body">
                  <span class="flex items-center gap-2">
                    <span class="episode__title"><%= ep[:title] || "Episode #{ep[:episode]}" %></span>
                    <% finished = @episode_finished&.dig([ ep[:season], ep[:episode] ]) %>
                    <% if finished %>
                      <span class="chip chip--sage shrink-0"><%= icon :check, css: "w-3 h-3" %> Watched</span>
                    <% elsif progress && progress.progress_percentage.positive? %>
                      <span class="chip chip--accent shrink-0"><%= progress.progress_percentage %>%</span>
                    <% end %>
                  </span>
                  <span class="episode__meta">
                    <%= ep[:released] %><% if ep[:runtime] %> · <%= ep[:runtime] %><% end %>
                  </span>
                  <% if ep[:overview].present? %>
                    <span class="episode__overview"><%= ep[:overview] %></span>
                  <% end %>
                  <% if progress %>
                    <span class="progress-track mt-2 block max-w-[18rem]">
                      <span class="progress-fill block" style="width: <%= progress.progress_percentage %>%"></span>
                    </span>
                  <% end %>
                </span>
                <span class="mt-1 text-ink-400 shrink-0 transition-transform" data-episode-picker-target="chevron">
                  <%= icon :chevron_down, css: "w-4 h-4" %>
                </span>
              </button>

              <div data-episode-picker-target="drawer" class="episode__drawer hidden">
                <div data-episode-picker-target="drawerContent" class="px-4 pb-4 pt-3">
                  <div class="flex items-center gap-2.5 text-sm text-ink-300">
                    <span class="h-4 w-4 rounded-full border-2 border-white/15 border-t-iris-500 animate-spin"></span>
                    Loading sources
                  </div>
                </div>
                <div class="flex flex-wrap items-center justify-between gap-3 border-t border-white/8 px-4 py-3">
                  <p class="text-xs text-ink-400">
                    <%= finished ? "This episode is marked watched." : "Finished this episode?" %>
                  </p>
                  <%= button_to finished ? "Mark unwatched" : "Mark watched",
                                content_watched_path(type: @type, imdb_id: @imdb_id),
                                method: :patch,
                                params: { watched: !finished, season: ep[:season], episode: ep[:episode], title: ep[:title], poster_url: @metadata[:poster_url], duration_seconds: ep[:runtime_seconds] },
                                class: "chip transition-colors hover:border-ink-400 hover:text-ink-50" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
<% else %>
  <div class="empty">
    <p class="kicker">Not found</p>
    <p class="empty__title">We could not load this title.</p>
    <p class="empty__text">It may have been removed from the catalogue, or the metadata service is unreachable right now.</p>
    <%= link_to "Back to home", root_path, class: "btn-secondary mt-2" %>
  </div>
<% end %>
