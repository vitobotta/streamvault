<%= render layout: "devise/shared/auth_shell", locals: { title: "Welcome back", subtitle: "Sign in to pick up where you left off." } do %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <div>
      <%= f.label :email, "Email", class: "field-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input-field", placeholder: "you@example.com" %>
    </div>

    <div>
      <div class="flex items-baseline justify-between gap-3">
        <%= f.label :password, "Password", class: "field-label" %>
        <% if devise_mapping.recoverable? %>
          <%= link_to "Forgot?", new_password_path(resource_name), class: "mb-1.5 text-xs text-iris-300 underline underline-offset-2 hover:text-iris-200" %>
        <% end %>
      </div>
      <%= f.password_field :password, autocomplete: "current-password", class: "input-field", placeholder: "Your password" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <label class="check pt-1">
        <%= f.check_box :remember_me, checked: true %>
        <span>Keep me signed in on this device</span>
      </label>
    <% end %>

    <%= f.submit "Sign in", class: "btn-primary btn-lg w-full cursor-pointer mt-2" %>
  <% end %>

  <div class="mt-8 space-y-2 text-center text-sm text-ink-400">
    <% if devise_mapping.registerable? && signups_enabled? %>
      <p>New here? <%= link_to "Create an account", new_registration_path(resource_name), class: "text-iris-300 hover:text-iris-200" %></p>
    <% end %>
  </div>
<% end %>
