<%= render layout: "devise/shared/auth_shell", locals: { title: "Choose a new password", subtitle: "Pick something you have not used before." } do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div>
      <%= f.label :password, "New password", class: "field-label" %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "input-field", placeholder: "Choose a new password" %>
      <% if @minimum_password_length %>
        <p class="field-hint"><%= @minimum_password_length %> characters minimum</p>
      <% end %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirm new password", class: "field-label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input-field", placeholder: "Repeat the new password" %>
    </div>

    <%= f.submit "Change my password", class: "btn-primary btn-lg w-full cursor-pointer mt-2" %>
  <% end %>

  <p class="mt-8 text-center text-sm text-ink-400">
    <%= link_to "Back to sign in", new_session_path(resource_name), class: "text-iris-300 hover:text-iris-200" %>
  </p>
<% end %>
