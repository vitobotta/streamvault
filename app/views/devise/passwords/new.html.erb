<%= render layout: "devise/shared/auth_shell", locals: { title: "Reset password", subtitle: "We will email you a link to choose a new password." } do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, "Email", class: "field-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input-field", placeholder: "you@example.com" %>
    </div>

    <%= f.submit "Send reset link", class: "btn-primary btn-lg w-full cursor-pointer mt-2" %>
  <% end %>

  <p class="mt-8 text-center text-sm text-ink-400">
    <%= link_to "Back to sign in", new_session_path(resource_name), class: "text-iris-300 hover:text-iris-200" %>
  </p>
<% end %>
