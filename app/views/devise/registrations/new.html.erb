<%= render layout: "devise/shared/auth_shell", locals: { title: "Create account", subtitle: "One profile, your own library, nothing shared." } do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, "Email", class: "field-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input-field", placeholder: "you@example.com" %>
    </div>

    <div>
      <%= f.label :password, "Password", class: "field-label" %>
      <%= f.password_field :password, autocomplete: "new-password", class: "input-field", placeholder: "Choose a password" %>
      <% if @minimum_password_length %>
        <p class="field-hint"><%= @minimum_password_length %> characters minimum</p>
      <% end %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirm password", class: "field-label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input-field", placeholder: "Repeat the password" %>
    </div>

    <%= f.submit "Create account", class: "btn-primary btn-lg w-full cursor-pointer mt-2" %>
  <% end %>

  <p class="mt-8 text-center text-sm text-ink-400">
    Already have an account? <%= link_to "Sign in", new_session_path(resource_name), class: "text-iris-300 hover:text-iris-200" %>
  </p>
<% end %>
