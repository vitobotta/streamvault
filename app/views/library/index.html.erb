<% type = params[:type].presence %>
<div class="mb-8 flex flex-col gap-5 md:mb-10 md:flex-row md:items-end md:justify-between">
  <div>
    <p class="kicker mb-2.5">Your collection</p>
    <h1 class="t-page">Library</h1>
    <p class="mt-2 text-sm text-ink-400">
      <% if @entries.any? %>
        <span class="t-num"><%= @pagination.total %></span> <%= @pagination.total == 1 ? "title" : "titles" %> saved
      <% else %>
        Everything you keep for later lives here
      <% end %>
    </p>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <div class="segmented" role="group" aria-label="Filter library by type">
      <%= link_to "All", library_index_path, class: "segmented__item #{type.blank? ? 'segmented__item--active' : ''}", "aria-current": (type.blank? ? "true" : nil) %>
      <%= link_to "Movies", library_index_path(type: :movie), class: "segmented__item #{type == 'movie' ? 'segmented__item--active' : ''}", "aria-current": (type == "movie" ? "true" : nil) %>
      <%= link_to "Series", library_index_path(type: :show), class: "segmented__item #{type == 'show' ? 'segmented__item--active' : ''}", "aria-current": (type == "show" ? "true" : nil) %>
    </div>
    <%= link_to search_index_path, class: "btn-ghost" do %>
      <%= icon :plus %> Add titles
    <% end %>
  </div>
</div>

<% if @entries.any? %>
  <div class="flex flex-wrap items-center justify-between gap-3 border-t border-white/8 pt-4 mb-6">
    <p class="text-xs text-ink-400 t-num">
      Showing <%= @pagination.first_item_number %>&ndash;<%= @pagination.last_item_number %> of <%= @pagination.total %>
    </p>
    <div class="page-size">
      <span class="kicker">Per page</span>
      <% [25, 50, 100].each do |size| %>
        <% if size == @pagination.per_page %>
          <span class="current t-num"><%= size %></span>
        <% else %>
          <%= link_to size, library_index_path(params.permit(:type).merge(per_page: size, page: 1)), class: "t-num" %>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="poster-grid">
    <% @entries.each do |entry| %>
      <% watched = entry.content_type == "movie" && @movie_watched_map&.dig(entry.imdb_id) %>
      <% watch_path = entry.content_type == "movie" ? content_watched_path(type: "movie", imdb_id: entry.imdb_id) : nil %>
      <%= render "shared/poster_card",
                 item: entry,
                 link_path: content_path(type: entry.content_type, imdb_id: entry.imdb_id),
                 subtitle: [entry.year, entry.content_type == "show" ? "Series" : "Film"].compact.join(" · "),
                 progress: @progress_map&.dig(entry.imdb_id),
                 series_progress: @series_progress_map&.dig(entry.imdb_id),
                 controls: :library,
                 watched: watched,
                 watch_path: watch_path,
                 watch_params: (watch_path ? { watched: !watched, title: entry.title, poster_url: entry.poster_url } : {}) %>
    <% end %>
  </div>

  <%= render "shared/pagination", pagination: @pagination, label: "Library" %>
<% else %>
  <div class="empty">
    <p class="kicker">Empty shelf</p>
    <p class="empty__title">Your library is waiting.</p>
    <p class="empty__text">Add a film or series and it will show up here, ready to stream whenever you are.</p>
    <%= link_to "Browse the catalogue", search_index_path, class: "btn-primary mt-2" %>
  </div>
<% end %>
