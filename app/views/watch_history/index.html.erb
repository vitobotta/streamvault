<div class="mb-8 flex flex-col gap-5 md:mb-10 md:flex-row md:items-end md:justify-between">
  <div>
    <p class="kicker mb-2.5">Activity</p>
    <h1 class="t-page">Watch history</h1>
    <p class="mt-2 text-sm text-ink-400">
      <% if @entries.any? %>
        <span class="t-num"><%= @pagination.total %></span> <%= @pagination.total == 1 ? "title" : "titles" %> watched recently
      <% else %>
        Every stream you start is listed here
      <% end %>
    </p>
  </div>
  <% if @entries.any? %>
    <%= button_to "Clear history", clear_all_watch_history_index_path, method: :delete,
                  class: "btn-danger",
                  data: { confirm: "Clear all watch history?" } %>
  <% end %>
</div>

<% if @entries.any? %>
  <div class="flex flex-wrap items-center justify-between gap-3 border-t border-white/8 pt-4 mb-2">
    <p class="text-xs text-ink-400 t-num">
      Showing <%= @pagination.first_item_number %>&ndash;<%= @pagination.last_item_number %> of <%= @pagination.total %>
    </p>
    <div class="page-size">
      <span class="kicker">Per page</span>
      <% [25, 50, 100].each do |size| %>
        <% if size == @pagination.per_page %>
          <span class="current t-num"><%= size %></span>
        <% else %>
          <%= link_to size, watch_history_index_path(per_page: size, page: 1), class: "t-num" %>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="row-list">
    <% @entries.each do |entry| %>
      <div class="row-item group">
        <%= link_to content_path(type: entry.episode? ? "show" : "movie", imdb_id: entry.imdb_id, season: entry.season_number, episode: entry.episode_number),
                    class: "absolute inset-0", data: { page_loader: "link" }, aria: { label: entry.title } do %>
          <span class="sr-only">Open <%= entry.title %></span>
        <% end %>
        <% if entry.poster_url.present? %>
          <img src="<%= poster_url_for(entry.poster_url) %>" alt="" loading="lazy" class="row-item__thumb pointer-events-none">
        <% else %>
          <div class="row-item__thumb bg-ink-850 grid place-items-center pointer-events-none">
            <span class="text-ink-400"><%= icon :history, css: "w-4 h-4" %></span>
          </div>
        <% end %>

        <div class="min-w-0 flex-1">
          <h3 class="text-sm font-medium text-ink-100 truncate"><%= entry.title %></h3>
          <p class="mt-0.5 text-xs text-ink-400 t-num">
            <% if entry.episode? %>
              S<%= format("%02d", entry.season_number.to_i) %>E<%= format("%02d", entry.episode_number.to_i) %>
              <span class="mx-1.5 text-ink-700">/</span>
            <% end %>
            <%= entry.progress_percentage %>% watched
          </p>
          <div class="progress-track mt-2 max-w-[16rem]">
            <div class="progress-fill" style="width: <%= entry.progress_percentage %>%"></div>
          </div>
        </div>

        <div class="relative z-10 flex shrink-0 items-center gap-3">
          <span class="hidden text-xs text-ink-400 sm:inline"><%= time_ago_in_words(entry.watched_at) %> ago</span>
          <% watched = entry.watched? %>
          <% watch_params = { watched: !watched, title: entry.title, poster_url: entry.poster_url, duration_seconds: entry.duration_seconds } %>
          <% if entry.episode? %>
            <% watch_params[:season] = entry.season_number %>
            <% watch_params[:episode] = entry.episode_number %>
          <% end %>
          <%= button_to content_watched_path(type: entry.episode? ? "show" : "movie", imdb_id: entry.imdb_id),
                        method: :patch,
                        params: watch_params,
                        class: "card-action #{'card-action--active' if watched}",
                        title: watched ? "Mark #{entry.title} unwatched" : "Mark #{entry.title} watched",
                        aria: { label: watched ? "Mark #{entry.title} unwatched" : "Mark #{entry.title} watched", pressed: watched } do %>
            <%= icon :check %>
          <% end %>
          <%= button_to watch_history_path(entry), method: :delete,
                        class: "card-action card-action--danger",
                        title: "Remove from history",
                        aria: { label: "Remove #{entry.title} from history" } do %>
            <%= icon :x %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <%= render "shared/pagination", pagination: @pagination, label: "Watch history" %>
<% else %>
  <div class="empty">
    <p class="kicker">No activity</p>
    <p class="empty__title">Nothing watched yet.</p>
    <p class="empty__text">Start any film or episode and it will appear here with your progress.</p>
    <%= link_to "Find something to watch", search_index_path, class: "btn-primary mt-2" %>
  </div>
<% end %>
