<%
  # Nothing to show yet: no history, no recommendations, empty library and wishlist.
  has_content = @continue_watching.any? ||
    (@recommendations.success? && @recommendations.data.any?) ||
    @recently_added.any? ||
    @wishlist_preview.any? ||
    (@popular.success? && @popular.data.any?)
%>

<header class="mb-8 md:mb-10">
  <p class="kicker mb-2.5"><%= Date.current.strftime("%A, %-d %B") %></p>
  <h1 class="t-page">Your cinema</h1>
</header>

<% unless has_content %>
  <section class="panel panel-pad mb-10">
    <p class="kicker mb-3">Welcome</p>
    <h2 class="t-section mb-3">Nothing saved yet.</h2>
    <p class="lede mb-6">Search for a film or series, then add it to your library. StreamVault keeps your place as you go.</p>
    <%= form_tag search_index_path, method: :get, class: "search-field max-w-xl", data: { page_loader: "search" } do %>
      <%= icon :search, css: "search-field__icon" %>
      <%= text_field_tag :q, nil, placeholder: "Search films and series", aria: { label: "Search movies and shows" } %>
      <%= submit_tag "Search", class: "btn-primary cursor-pointer" %>
    <% end %>
  </section>
<% end %>

<% unless current_user.has_realdebrid_key? %>
  <div class="notice-bar mb-8">
    <%= icon :lock, css: "w-4 h-4 shrink-0 text-iris-300" %>
    <p>
      Streaming needs your RealDebrid API key.
      <%= link_to "Add it in Settings", settings_path %> to enable playback.
    </p>
  </div>
<% end %>

<% if @continue_watching.any? %>
  <%= render layout: "shared/rail", locals: { title: "Continue watching", count: "#{@continue_watching.size} titles", view_all_path: watch_history_index_path, emphasized: true } do %>
    <% @continue_watching.each_with_index do |item, index| %>
      <%= render "shared/poster_card",
                 item: item,
                 priority: index < 4,
                 link_path: resume_streaming_index_path(type: item[:content_type] == "episode" ? "show" : "movie", imdb_id: item[:imdb_id]),
                 subtitle: item[:content_type] == "episode" ? [ "S#{format('%02d', item[:season].to_i)}E#{format('%02d', item[:episode].to_i)}", item[:episode_title] ].compact.join(" · ") : "Continue",
                 progress: item[:progress_percentage],
                 remove_path: watch_history_path(item[:history_id]),
                 remove_method: :delete,
                 remove_label: "Remove #{item[:title]} from Continue Watching" %>
    <% end %>
  <% end %>
<% end %>

<% if @recommendations.success? && @recommendations.data.any? %>
  <%= render layout: "shared/rail", locals: { title: "Recommended for you", count: "#{@recommendations.data.size} titles" } do %>
    <% @recommendations.data.each_with_index do |item, index| %>
      <%= render "shared/poster_card",
                 item: item,
                 priority: index < 4 && @continue_watching.empty?,
                 link_path: content_path(type: item[:type], imdb_id: item[:imdb_id]),
                 subtitle: [item[:year], item[:type] == "show" ? "Series" : "Film"].compact.join(" · ") %>
    <% end %>  <% end %>
<% end %>

<% if @recently_added.any? %>
  <%= render layout: "shared/rail", locals: { title: "Recently added", count: @recently_added.size, view_all_path: library_index_path } do %>
    <% @recently_added.each do |entry| %>
      <%= render "shared/poster_card",
                 item: { imdb_id: entry.imdb_id, title: entry.title, poster_url: entry.poster_url, year: entry.year, type: entry.content_type },
                 link_path: content_path(type: entry.content_type, imdb_id: entry.imdb_id),
                 subtitle: [entry.year, entry.content_type == "show" ? "Series" : "Film"].compact.join(" · ") %>
    <% end %>
  <% end %>
<% end %>

<% if @wishlist_preview.any? %>
  <%= render layout: "shared/rail", locals: { title: "Your wishlist", count: @wishlist_preview.size, view_all_path: wishlist_index_path } do %>
    <% @wishlist_preview.each do |entry| %>
      <%= render "shared/poster_card",
                 item: { imdb_id: entry.imdb_id, title: entry.title, poster_url: entry.poster_url, year: entry.year, type: entry.content_type },
                 link_path: content_path(type: entry.content_type, imdb_id: entry.imdb_id),
                 subtitle: [entry.year, entry.content_type == "show" ? "Series" : "Film"].compact.join(" · ") %>
    <% end %>
  <% end %>
<% end %>

<% if @popular.success? && @popular.data.any? %>
  <%= render layout: "shared/rail", locals: { title: "Popular movies", count: "#{@popular.data.size} titles" } do %>
    <% @popular.data.each do |item| %>
      <%= render "shared/poster_card", item: item, link_path: content_path(type: "movie", imdb_id: item[:imdb_id]), subtitle: item[:year] %>
    <% end %>
  <% end %>
<% end %>

<% if @trending.success? && @trending.data.any? %>
  <%= render layout: "shared/rail", locals: { title: "Trending this year", count: "#{@trending.data.size} titles" } do %>
    <% @trending.data.each do |item| %>
      <%= render "shared/poster_card", item: item, link_path: content_path(type: "movie", imdb_id: item[:imdb_id]), subtitle: item[:year] %>
    <% end %>
  <% end %>
<% end %>

<% if @popular_shows.success? && @popular_shows.data.any? %>
  <%= render layout: "shared/rail", locals: { title: "Popular series", count: "#{@popular_shows.data.size} titles" } do %>
    <% @popular_shows.data.each do |item| %>
      <%= render "shared/poster_card", item: item, link_path: content_path(type: "show", imdb_id: item[:imdb_id]), subtitle: item[:year] %>
    <% end %>
  <% end %>
<% end %>

<% if @trending_shows.success? && @trending_shows.data.any? %>
  <%= render layout: "shared/rail", locals: { title: "Series to start", count: "#{@trending_shows.data.size} titles" } do %>
    <% @trending_shows.data.each do |item| %>
      <%= render "shared/poster_card", item: item, link_path: content_path(type: "show", imdb_id: item[:imdb_id]), subtitle: item[:year] %>
    <% end %>
  <% end %>
<% end %>
