<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title><%= content_for(:title) || "StreamVault" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="StreamVault">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#080a0e">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="<%= versioned_icon_path("/icon.png") %>" type="image/png">
    <link rel="icon" href="<%= versioned_icon_path("/icon.svg") %>" type="image/svg+xml">
    <link rel="apple-touch-icon" href="<%= versioned_icon_path("/icon.png") %>">
    <link rel="preload" href="/fonts/instrument-sans.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/instrument-serif.woff2" as="font" type="font/woff2" crossorigin>
    <% if !user_signed_in? %>
      <link rel="preload" href="https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=1920&q=80" as="image">
    <% end %>

    <%# Tailwind compiled CSS + custom styles %>
    <%= stylesheet_link_tag "tailwind" %>
    <%= stylesheet_link_tag "application" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full" data-controller="page-loader">
    <%# Page loading overlay - shown during search and content navigation %>
    <div data-page-loader-target="overlay"
         class="hidden fixed inset-0 z-[60] bg-black/85 flex items-center justify-center"
         role="status" aria-live="polite" aria-hidden="true">
      <div class="flex flex-col items-center gap-4 px-7 py-6 rounded-2xl border border-white/10 bg-ink-900/95 shadow-2xl">
        <div class="w-9 h-9 rounded-full border-2 border-white/15 border-t-iris-500 animate-spin"></div>
        <div class="kicker" data-page-loader-target="message">Loading</div>
      </div>
    </div>

    <% if user_signed_in? %>
      <div class="app-shell">
        <%# Desktop sidebar %>
        <aside class="app-sidebar">
          <%= link_to root_path, class: "wordmark px-2" do %>
            <%= render "shared/brand_mark", css: "wordmark__mark" %>
            <span class="wordmark__text">StreamVault</span>
          <% end %>

          <%= form_tag search_index_path, method: :get, class: "sidebar-search", data: { page_loader: "search" } do %>
            <%= icon :search %>
            <%= text_field_tag :q, nil, placeholder: "Search titles", aria: { label: "Search movies and shows" } %>
          <% end %>

          <nav class="app-nav" aria-label="Primary">
            <p class="nav-group-label">Browse</p>
            <%= link_to root_path, class: "nav-link #{'active' if controller_name == 'home'}", "aria-current": (controller_name == "home" ? "page" : nil) do %>
              <%= icon :home %><span>Home</span>
            <% end %>
            <%= link_to search_index_path, class: "nav-link #{'active' if controller_name == 'search'}", "aria-current": (controller_name == "search" ? "page" : nil) do %>
              <%= icon :search %><span>Search</span>
            <% end %>
            <%= link_to library_index_path, class: "nav-link #{'active' if controller_name == 'library'}", "aria-current": (controller_name == "library" ? "page" : nil) do %>
              <%= icon :library %><span>Library</span>
            <% end %>
            <%= link_to wishlist_index_path, class: "nav-link #{'active' if controller_name == 'wishlist'}", "aria-current": (controller_name == "wishlist" ? "page" : nil) do %>
              <%= icon :wishlist %><span>Wishlist</span>
            <% end %>
            <%= link_to watch_history_index_path, class: "nav-link #{'active' if controller_name == 'watch_history'}", "aria-current": (controller_name == "watch_history" ? "page" : nil) do %>
              <%= icon :history %><span>History</span>
            <% end %>

            <p class="nav-group-label">Account</p>
            <%= link_to settings_path, class: "nav-link #{'active' if controller_name == 'settings'}", "aria-current": (controller_name == "settings" ? "page" : nil) do %>
              <%= icon :settings %><span>Settings</span>
            <% end %>
          </nav>

          <div class="account-card">
            <span class="avatar" aria-hidden="true"><%= account_initials(current_user) %></span>
            <div class="min-w-0 flex-1">
              <p class="account-card__name"><%= account_name(current_user) %></p>
              <p class="account-card__meta"><%= current_user.child_account? ? "Child profile" : current_user.email %></p>
            </div>
            <%= button_to destroy_user_session_path, method: :delete, class: "icon-button", title: "Sign out", aria: { label: "Sign out" } do %>
              <%= icon :logout %>
            <% end %>
          </div>
        </aside>

        <%# Main column %>
        <div class="app-main">
          <header class="mobile-header">
            <%= link_to root_path, class: "wordmark" do %>
              <%= render "shared/brand_mark", css: "wordmark__mark" %>
              <span class="wordmark__text">StreamVault</span>
            <% end %>
            <div class="flex items-center gap-1">
              <%= link_to search_index_path, class: "icon-button", aria: { label: "Search" } do %>
                <%= icon :search %>
              <% end %>
              <%= link_to settings_path, class: "icon-button", aria: { label: "Settings" } do %>
                <span class="avatar" style="width: 1.75rem; height: 1.75rem; font-size: 0.8125rem;"><%= account_initials(current_user) %></span>
              <% end %>
            </div>
          </header>

          <main class="app-content">
            <% if current_user.child_account? %>
              <div class="notice-bar mb-6">
                <%= icon :lock, css: "w-4 h-4 shrink-0 text-iris-300" %>
                <p>
                  <span class="font-medium text-ink-50">Child account for age <%= current_user.max_rating_age %>.</span>
                  Search results and playback are restricted to titles rated for that age.
                </p>
              </div>
            <% end %>

            <% if notice.present? %>
              <div class="flash-notice mb-6" data-controller="flash" data-flash-target="message">
                <%= notice %>
              </div>
            <% end %>
            <% if alert.present? %>
              <div class="flash-alert mb-6" data-controller="flash" data-flash-target="message">
                <%= alert %>
              </div>
            <% end %>

            <% if parental_rating_sources_missing? %>
              <div class="flash-alert mb-6" role="status">
                This account is limited to age <%= current_user.max_rating_age %>, but no film rating source is
                configured, so every title counts as unrated and is hidden. Set
                <code>OMDB_API_KEY</code> or <code>TMDB_READ_ACCESS_TOKEN</code> and restart the app.
              </div>
            <% end %>

            <%= yield %>
          </main>
        </div>
      </div>

      <%# Mobile bottom navigation %>
      <nav class="mobile-nav" aria-label="Primary">
        <%= link_to root_path, class: "mobile-nav__link #{'active' if controller_name == 'home'}" do %>
          <%= icon :home %><span>Home</span>
        <% end %>
        <%= link_to search_index_path, class: "mobile-nav__link #{'active' if controller_name == 'search'}" do %>
          <%= icon :search %><span>Search</span>
        <% end %>
        <%= link_to library_index_path, class: "mobile-nav__link #{'active' if controller_name == 'library'}" do %>
          <%= icon :library %><span>Library</span>
        <% end %>
        <%= link_to wishlist_index_path, class: "mobile-nav__link #{'active' if controller_name == 'wishlist'}" do %>
          <%= icon :wishlist %><span>Wishlist</span>
        <% end %>
        <%= link_to watch_history_index_path, class: "mobile-nav__link #{'active' if controller_name == 'watch_history'}" do %>
          <%= icon :history %><span>History</span>
        <% end %>
      </nav>
    <% else %>
      <div class="min-h-screen">
        <%= yield %>
      </div>
    <% end %>
  </body>
</html>
